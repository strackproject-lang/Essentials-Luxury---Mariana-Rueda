body {
  font-family: system-ui, Arial, sans-serif;
  background-color: #f4f4f4;
  color: #333;
  padding: 20px;
  margin: 0;
  text-align: center;
}

h1 {
  color: #222;
  margin-bottom: 8px;
}

.slogan {
  color: #666;
  font-size: 17px;
  margin-top: 0;
  margin-bottom: 25px;
}

/* Beneficios de la tienda */

.beneficios {
  display: flex;
  justify-content: center;
  gap: 30px;
  flex-wrap: wrap;

  background-color: #222;
  color: white;

  padding: 14px;
  margin-bottom: 30px;
}

.beneficios span {
  font-size: 14px;
}

/* Catálogo */

#productos {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 15px;
}

.producto {
  border: 1px solid #ccc;
  background: white;
  border-radius: 8px;
  padding: 10px;
  width: 220px;
  vertical-align: top;
}

.producto img {
  width: 100%;
  height: 140px;
  object-fit: cover;
  border-radius: 4px;
}

.producto h3 {
  margin-bottom: 8px;
}

.descripcion {
  font-size: 14px;
  color: #666;
  min-height: 42px;
}

.precio {
  font-size: 18px;
  font-weight: bold;
  color: #222;
}

/* Botones */

.producto button {
  background-color: #28a745;
  border: none;
  color: white;
  padding: 9px 12px;
  margin-top: 5px;
  border-radius: 4px;
  cursor: pointer;
}

.producto button:hover {
  opacity: 0.85;
}

/* Carrito */

.carrito {
  margin-top: 35px;
  padding: 20px;
  background: white;
  border-radius: 8px;
  text-align: left;
  display: inline-block;
  min-width: 320px;
}

.carrito h2 {
  margin-top: 0;
}

#lista-carrito {
  padding-left: 20px;
}

#lista-carrito li {
  margin-bottom: 8px;
}

.resumen {
  border-top: 1px solid #ddd;
  margin-top: 15px;
  padding-top: 10px;
}

.total {
  font-size: 19px;
}

/* Botón vaciar */

.vaciar {
  background-color: #dc3545;
  border: none;
  color: white;
  padding: 9px 12px;
  margin-top: 10px;
  border-radius: 4px;
  cursor: pointer;
}

/* Botón finalizar */

.finalizar {
  background-color: #007bff;
  border: none;
  color: white;
  padding: 9px 12px;
  margin-top: 10px;
  margin-left: 5px;
  border-radius: 4px;
  cursor: pointer;
}

.vaciar:hover,
.finalizar:hover {
  opacity: 0.85;
}
